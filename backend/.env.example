# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Metron (https://metron.cloud): either an API token, or your account username + password
METRON_API_TOKEN=
METRON_USERNAME=
METRON_PASSWORD=

# Comic Vine (https://comicvine.gamespot.com/api/): free key, non-commercial use
COMICVINE_API_KEY=

# Protects the curation/admin API. Leave empty for a local single-user setup.
ADMIN_TOKEN=

# Where the database, caches and imported library files live.
# Default: %LOCALAPPDATA%\ComixCenter on Windows (kept out of OneDrive on purpose,
# since syncing a live SQLite database can corrupt it).
COMIX_DATA_DIR=

# Extra folders to scan for comics you own (separated by ';')
COMIX_SCAN_DIRS=
