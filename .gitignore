# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Secrets and local data
.env
*.db
*.db-wal
*.db-shm

# Browser profiles hold session cookies; never commit them
.browser-profile/
chrome_profile/

# Generated output and local probes
backend/test_output/
scratch/

# Web / Android build output
node_modules/
web/.next/
web/out/
web/android/app/build/
web/android/.gradle/
web/android/build/
*.apk

# TypeScript incremental build info
*.tsbuildinfo

# Engine runtime assets copied from node_modules at build time
web/public/wasm/
web/public/pdf.worker.min.mjs

# Local environment files can contain provider credentials
.env*.local
.vercel/
.env*
